{
  "name": "agro-app-api",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc -p tsconfig.json",
    "prisma:generate": "node ../../scripts/prisma-with-root-env.js generate",
    "prisma:validate": "node ../../scripts/prisma-with-root-env.js validate",
    "db:migrate": "node ../../scripts/prisma-with-root-env.js migrate dev",
    "db:deploy": "node ../../scripts/prisma-with-root-env.js migrate deploy",
    "db:seed": "ts-node-dev --transpile-only --exit-child prisma/seed.ts",
    "erp:test": "ts-node-dev --transpile-only --exit-child src/scripts/probarConexionErpCli.ts",
    "erp:list:empresas": "ts-node-dev --transpile-only --exit-child src/scripts/listarEmpresasErpCli.ts",
    "erp:sync:empresas": "ts-node-dev --transpile-only --exit-child src/scripts/sincronizarEmpresasErpCli.ts",
    "erp:sync": "ts-node-dev --transpile-only --exit-child src/scripts/sincronizarErpCli.ts",
    "erp:verify": "ts-node-dev --transpile-only --exit-child src/scripts/verificarSyncErpCli.ts"
  },
  "prisma": {
    "seed": "ts-node-dev --transpile-only --exit-child prisma/seed.ts"
  },
  "dependencies": {
    "@agro/tipos": "workspace:*",
    "@prisma/client": "^5.10.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "bcryptjs": "^3.0.3",
    "body-parser": "^1.20.3",
    "cors": "^2.8.5",
    "express": "^4.18.4",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "@types/body-parser": "^1.19.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.18",
    "prisma": "^5.10.0",
    "ts-node-dev": "^2.0.0"
  }
}
