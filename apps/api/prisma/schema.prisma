generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id          String    @id @default(uuid())
  email       String    @unique
  nombre      String?
  password    String?
  microsoftId String?   @unique
  rol         String    @default("usuario")
  cliente     Cliente?  @relation(fields: [clienteId], references: [id])
  clienteId   String?
  campos      Campo[]
  camposErpAsignados UsuarioCampoErp[]
  notificaciones NotificacionUsuario[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Cliente {
  id               String            @id @default(uuid())
  nombre           String
  activo           Boolean           @default(true)
  usuarios         Usuario[]
  integracionesErp IntegracionErp[]
  camposErpAsignados UsuarioCampoErp[]
  empresasErpAsignadas ClienteEmpresaErp[]
  zonasPlanificacion ZonaPlanificacion[]
  camposPlanificacion CampoPlanificacion[]
  lotesPlanificacion LotePlanificacion[]
  especiesPlanificacion EspeciePlanificacion[]
  actividadesPlanificacion ActividadPlanificacion[]
  insumosPlanificacion InsumoPlanificacion[]
  estadiosReferencia EstadioFenologicoReferencia[]
  laboresReferencia LaborReferencia[]
  protocolosProductivos ProtocoloProductivo[]
  planificacionesAgricolas PlanificacionAgricola[]
  preciosReferencia PrecioReferencia[]
  destinosVentaReferencia DestinoVentaReferencia[]
  conceptosGastosComerciales ConceptoGastoComercial[]
  gastosComercialesReferencia GastosComercialesReferencia[]
  vinculacionesErpSugeridas VinculacionErpSugerida[]
  notificaciones NotificacionUsuario[]
  auditoriaEventos AuditoriaEvento[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model UsuarioCampoErp {
  id           String    @id @default(uuid())
  cliente     Cliente   @relation(fields: [clienteId], references: [id])
  clienteId    String
  usuario      Usuario   @relation(fields: [usuarioId], references: [id])
  usuarioId    String
  campoErpId   String
  asignadoPor  String?
  createdAt    DateTime  @default(now())

  @@unique([clienteId, usuarioId, campoErpId])
  @@index([clienteId])
  @@index([usuarioId])
  @@index([campoErpId])
}

model IntegracionErp {
  id                  String    @id @default(uuid())
  cliente             Cliente   @relation(fields: [clienteId], references: [id])
  clienteId           String
  baseUrl             String?
  authMode            String    @default("mock")
  apiKeyHeader        String    @default("x-api-key")
  apiKeyCifrada       String?
  bearerTokenCifrado  String?
  usernameCifrado     String?
  passwordCifrada     String?
  timeoutMs           Int       @default(15000)
  activo              Boolean   @default(true)
  ultimoTestOk        Boolean?
  ultimoTestEn        DateTime?
  ultimoSyncEn        DateTime?
  configuradoPor      String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@unique([clienteId])
  @@index([activo])
}

model Pais {
  id        String   @id @default(uuid())
  nombre    String
  codigo    String   @unique
  campos    Campo[]
}

model Campo {
  id          String      @id @default(uuid())
  nombre      String
  pais        Pais        @relation(fields: [paisId], references: [id])
  paisId      String
  lotes       Lote[]
  usuario     Usuario     @relation(fields: [usuarioId], references: [id])
  usuarioId   String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Lote {
  id             String           @id @default(uuid())
  nombre         String
  area           Float
  campo          Campo            @relation(fields: [campoId], references: [id])
  campoId        String
  tipoSemilla    String
  cultivo        Cultivo          @relation(fields: [cultivoId], references: [id])
  cultivoId      String
  labores        Labor[]
  analisisSuelo  AnalisisSuelo[]
  avanceSiembra  AvanceSiembra[]
  avanceCosecha  AvanceCosecha[]
  monitoreos     Monitoreo[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

model Cultivo {
  id     String @id @default(uuid())
  nombre String
  lotes  Lote[]
}

model Labor {
  id        String   @id @default(uuid())
  lote      Lote     @relation(fields: [loteId], references: [id])
  loteId    String
  tipo      String
  fecha     DateTime
  notas     String?
}

model AnalisisSuelo {
  id             String   @id @default(uuid())
  lote           Lote     @relation(fields: [loteId], references: [id])
  loteId         String
  ph             Float?
  materiaOrganica Float?
  nitrogeno      Float?
  fosforo        Float?
  potasio        Float?
  notas          String?
  fecha          DateTime
}

model AvanceSiembra {
  id        String   @id @default(uuid())
  lote      Lote     @relation(fields: [loteId], references: [id])
  loteId    String
  fecha     DateTime
  area      Float
  createdAt DateTime @default(now())
}

model AvanceCosecha {
  id        String   @id @default(uuid())
  lote      Lote     @relation(fields: [loteId], references: [id])
  loteId    String
  fecha     DateTime
  tonelaje  Float
  humedad   Float?
  camion    String?
  notas     String?
  createdAt DateTime @default(now())
}

model Monitoreo {
  id           String   @id @default(uuid())
  lote         Lote     @relation(fields: [loteId], references: [id])
  loteId       String
  tipo         String
  severidad    String?
  notas        String?
  coordenadas  String?
  fecha        DateTime
  createdAt    DateTime @default(now())
}

model ErpCampo {
  id             String    @id @default(uuid())
  empresaErpId   String
  erpId          String    @unique
  idCampo        Int
  idZona         Int?
  idSubZona      Int?
  codigo         String
  nombre         String
  paisCodigo     String?
  sociedad       String?
  admiteGanaderia Boolean?
  domicilio      String?
  codigoSima     Int?
  idLocalidad    Int?
  activo         Boolean   @default(true)
  actualizadoEn  DateTime
  importadoEn    DateTime  @default(now())
  lotes          ErpLote[]

  @@index([codigo])
  @@index([activo])
  @@index([empresaErpId])
}

model ErpZona {
  id           String   @id @default(uuid())
  empresaErpId String
  erpId        String   @unique
  idZona       Int
  codigo       String
  nombre       String
  activo       Boolean  @default(true)
  importadoEn  DateTime @default(now())

  @@index([codigo])
  @@index([activo])
  @@index([empresaErpId])
}

model ErpLote {
  id             String         @id @default(uuid())
  empresaErpId   String
  erpId          String         @unique
  idLote         Int
  idCampo        Int
  campoErpId     String
  campo          ErpCampo       @relation(fields: [campoErpId], references: [erpId])
  codigo         String
  nombre         String
  cultivoCodigo  String?
  cultivoNombre  String?
  areaHectareas  Float
  hectareasProductivas Float?
  admiteGanaderia Boolean?
  admiteLecheria  Boolean?
  codigoSima     Int?
  activo         Boolean        @default(true)
  actualizadoEn  DateTime
  importadoEn    DateTime       @default(now())

  @@index([idLote])
  @@index([idCampo])
  @@index([campoErpId])
  @@index([codigo])
  @@index([activo])
  @@index([empresaErpId])
}

model ErpActividad {
  id                String    @id @default(uuid())
  empresaErpId      String
  erpId             String    @unique
  idActividad       Int
  codigo            String
  descripcion       String
  activo            Boolean
  habilitadoExportacionCrea Boolean
  idEspecie         Int?
  idTipoActividad   Int?
  actualizadoEn     DateTime
  importadoEn       DateTime  @default(now())

  @@index([idActividad])
  @@index([idTipoActividad])
  @@index([activo])
  @@index([empresaErpId])
}

model ErpEspecie {
  id             String    @id @default(uuid())
  empresaErpId   String
  erpId          String    @unique
  idEspecie      Int
  codigo         String
  nombre         String
  activo         Boolean
  codigoCot      String?
  codigoAfip     Int?
  actualizadoEn  DateTime
  importadoEn    DateTime  @default(now())

  @@index([idEspecie])
  @@index([codigo])
  @@index([activo])
  @@index([empresaErpId])
}

model ErpEmpresa {
  id             String    @id @default(uuid())
  erpId          String    @unique
  idEmpresa      Int
  codigo         String
  nombre         String
  activo         Boolean
  cuit           String?
  razonSocial    String?
  email          String?
  actualizadoEn  DateTime
  importadoEn    DateTime  @default(now())

  @@index([idEmpresa])
  @@index([codigo])
  @@index([activo])
}

model ErpCampania {
  id             String    @id @default(uuid())
  empresaErpId   String
  erpId          String    @unique
  idCampania     Int
  codigo         String
  nombre         String
  activo         Boolean
  esActual       Boolean
  actualizadoEn  DateTime
  importadoEn    DateTime  @default(now())

  @@index([empresaErpId])
  @@index([idCampania])
  @@index([codigo])
  @@index([activo])
  @@index([esActual])
}

model ErpCultivo {
  id                       String    @id @default(uuid())
  empresaErpId             String
  erpId                    String    @unique
  idCultivo                Int
  codigo                   String
  nombre                   String
  idCampo                  Int
  campoErpId               String
  idLote                   Int
  loteErpId                String
  idActividad              Int?
  actividadErpId           String?
  idEspecie                Int?
  especieErpId             String?
  idCampania               Int?
  campaniaErpId            String?
  hectareas                Float
  hectareasSembradas       Float
  hectareasCosechadas      Float
  idPuerto                 Int?
  distanciaPuerto          Float?
  idPersonalResponsable    Int?
  esAgriculturaIntensiva   Boolean
  socioEnFuncionAportes    Boolean
  activo                   Boolean
  actualizadoEn            DateTime
  importadoEn              DateTime  @default(now())

  @@index([empresaErpId])
  @@index([idCultivo])
  @@index([campoErpId])
  @@index([loteErpId])
  @@index([campaniaErpId])
  @@index([activo])
}

model ErpInsumo {
  id                      String    @id @default(uuid())
  empresaErpId            String
  erpId                   String    @unique
  idInsumo                Int
  idUnidadMedida          Int?
  idTipoInsumo            Int?
  idCategoriaInsumo       Int?
  codigo                  String
  nombre                  String
  activo                  Boolean
  controlaStock           Boolean
  esInsumoGenerico        Boolean
  controlaPorLote         Boolean
  precioUnitario          Float?
  precioUnitarioVenta     Float?
  unidadesBulto           Float?
  idMonedaPrecioUnitario  Int?
  idMonedaPrecioVenta     Int?
  idCuentaContable        Int?
  idInsumoBanda           Int?
  idInsumoEstandar        Int?
  actualizadoEn           DateTime
  importadoEn             DateTime  @default(now())

  @@index([empresaErpId])
  @@index([idInsumo])
  @@index([codigo])
  @@index([nombre])
  @@index([idTipoInsumo])
  @@index([idCategoriaInsumo])
  @@index([activo])
}

model ErpServicio {
  id                    String    @id @default(uuid())
  empresaErpId          String
  erpId                 String    @unique
  idServicio            Int
  idTipoServicio        Int?
  codigo                String
  descripcion           String
  descripcionAbreviada  String?
  idUnidadMedida        Int?
  idMoneda              Int?
  precioUnitario        Float?
  idMonedaPersonal      Int?
  importePersonal       Float?
  activo                Boolean
  imputaDosis           Boolean
  actualizadoEn         DateTime
  importadoEn           DateTime  @default(now())

  @@index([empresaErpId])
  @@index([idServicio])
  @@index([codigo])
  @@index([descripcion])
  @@index([idTipoServicio])
  @@index([idUnidadMedida])
  @@index([activo])
}

model ErpUnidadMedida {
  id                    String    @id @default(uuid())
  empresaErpId          String
  erpId                 String    @unique
  idUnidadMedida        Int
  codigo                String
  codigoSifen           String?
  descripcion           String
  activo                Boolean
  actualizadoEn         DateTime
  importadoEn           DateTime  @default(now())

  @@index([empresaErpId])
  @@index([idUnidadMedida])
  @@index([codigo])
  @@index([activo])
}

model ClienteEmpresaErp {
  id           String    @id @default(uuid())
  cliente      Cliente   @relation(fields: [clienteId], references: [id])
  clienteId    String
  empresaErpId String
  asignadoPor  String?
  createdAt    DateTime  @default(now())

  @@unique([clienteId, empresaErpId])
  @@index([clienteId])
  @@index([empresaErpId])
}

model ZonaPlanificacion {
  id                String   @id @default(uuid())
  cliente           Cliente  @relation(fields: [clienteId], references: [id])
  clienteId         String
  empresaErpId      String
  zonaErpId         String?
  nombre            String
  codigoInterno     String?
  estadoVinculacion String   @default("provisorio")
  createdBy         String?
  updatedBy         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  campos            CampoPlanificacion[]
  protocolos        ProtocoloProductivo[]

  @@index([clienteId])
  @@index([empresaErpId])
  @@index([zonaErpId])
  @@index([estadoVinculacion])
}

model CampoPlanificacion {
  id                String   @id @default(uuid())
  cliente           Cliente  @relation(fields: [clienteId], references: [id])
  clienteId         String
  empresaErpId      String
  campoErpId        String?
  zonaPlanificacion ZonaPlanificacion? @relation(fields: [zonaPlanificacionId], references: [id])
  zonaPlanificacionId String?
  zonaErpId         String?
  nombre            String
  codigoInterno     String?
  estadoVinculacion String   @default("provisorio")
  createdBy         String?
  updatedBy         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  lotes             LotePlanificacion[]
  protocolos        ProtocoloProductivo[]
  lineasPlanificacion PlanificacionAgricolaLinea[]

  @@index([clienteId])
  @@index([empresaErpId])
  @@index([campoErpId])
  @@index([zonaPlanificacionId])
  @@index([estadoVinculacion])
}

model LotePlanificacion {
  id                String   @id @default(uuid())
  cliente           Cliente  @relation(fields: [clienteId], references: [id])
  clienteId         String
  campo             CampoPlanificacion @relation(fields: [campoPlanificacionId], references: [id])
  campoPlanificacionId String
  loteErpId         String?
  nombre            String
  codigoInterno     String?
  superficieTotal   Float
  superficieProductiva Float
  estadoVinculacion String   @default("provisorio")
  createdBy         String?
  updatedBy         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  lineasPlanificacion PlanificacionAgricolaLinea[]

  @@index([clienteId])
  @@index([campoPlanificacionId])
  @@index([loteErpId])
  @@index([estadoVinculacion])
}

model EspeciePlanificacion {
  id                String   @id @default(uuid())
  cliente           Cliente  @relation(fields: [clienteId], references: [id])
  clienteId         String
  empresaErpId      String
  especieErpId      String?
  nombre            String
  codigoInterno     String?
  estadoVinculacion String   @default("provisorio")
  createdBy         String?
  updatedBy         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  actividades       ActividadPlanificacion[]
  preciosReferencia PrecioReferencia[]

  @@index([clienteId])
  @@index([empresaErpId])
  @@index([especieErpId])
  @@index([estadoVinculacion])
}

model ActividadPlanificacion {
  id                    String   @id @default(uuid())
  cliente               Cliente  @relation(fields: [clienteId], references: [id])
  clienteId             String
  empresaErpId          String
  actividadErpId        String?
  especiePlanificacion  EspeciePlanificacion? @relation(fields: [especiePlanificacionId], references: [id])
  especiePlanificacionId String?
  especieErpId          String?
  nombre                String
  codigoInterno         String?
  estadoVinculacion     String   @default("provisorio")
  createdBy             String?
  updatedBy             String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  protocolos            ProtocoloProductivo[]
  lineasPlanificacion   PlanificacionAgricolaLinea[]
  destinosReferencia    DestinoVentaReferencia[]
  preciosReferencia     PrecioReferencia[]
  gastosReferencia      GastosComercialesReferencia[]

  @@index([clienteId])
  @@index([empresaErpId])
  @@index([actividadErpId])
  @@index([especiePlanificacionId])
  @@index([estadoVinculacion])
}

model InsumoPlanificacion {
  id                    String   @id @default(uuid())
  cliente               Cliente  @relation(fields: [clienteId], references: [id])
  clienteId             String
  empresaErpId          String
  insumoErpId           String?
  nombre                String
  codigoInterno         String?
  tipo                  String?
  unidad                String
  precioUnitarioEstimado Float?
  moneda                String?
  estadoVinculacion     String   @default("provisorio")
  createdBy             String?
  updatedBy             String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  insumosProtocolo      ProtocoloInsumo[]

  @@index([clienteId])
  @@index([empresaErpId])
  @@index([insumoErpId])
  @@index([estadoVinculacion])
}

model EstadioFenologicoReferencia {
  id                String   @id @default(uuid())
  cliente           Cliente  @relation(fields: [clienteId], references: [id])
  clienteId         String
  idEstadio         Int
  actividadErpId    String?
  codigo            String
  nombre            String
  ordenCronologico  Int
  empresaErpId      String?
  activo            Boolean  @default(true)
  origen            String   @default("semilla")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  etapas            ProtocoloEtapa[]

  @@unique([clienteId, idEstadio])
  @@index([clienteId])
  @@index([actividadErpId])
  @@index([codigo])
  @@index([ordenCronologico])
  @@index([activo])
}

model LaborReferencia {
  id                    String   @id @default(uuid())
  cliente               Cliente  @relation(fields: [clienteId], references: [id])
  clienteId             String
  empresaErpId          String?
  servicioErpId         String?
  idServicio            Int?
  idTipoServicio        Int?
  codigo                String
  nombre                String
  descripcionAbreviada  String?
  idUnidadMedida        Int?
  idMoneda              Int?
  unidadSugerida        String
  costoUnitarioSugerido Float?
  imputaDosis           Boolean?
  estadoVinculacion     String   @default("provisorio")
  activo                Boolean  @default(true)
  origen                String   @default("semilla")
  fechaUltimaActualizacionErp DateTime?
  createdBy             String?
  updatedBy             String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  labores               ProtocoloLabor[]

  @@unique([clienteId, codigo])
  @@unique([clienteId, servicioErpId])
  @@index([clienteId])
  @@index([empresaErpId])
  @@index([servicioErpId])
  @@index([nombre])
  @@index([estadoVinculacion])
  @@index([activo])
}

model ProtocoloProductivo {
  id                    String   @id @default(uuid())
  cliente               Cliente  @relation(fields: [clienteId], references: [id])
  clienteId             String
  nombre                String
  descripcion           String
  protocoloOrigenId     String?
  empresaErpId          String?
  campaniaErpId         String
  actividadPlanificacion ActividadPlanificacion @relation(fields: [actividadPlanificacionId], references: [id])
  actividadPlanificacionId String
  actividadErpId        String?
  tipoFecha             String
  fechaSiembra          DateTime?
  zonaPlanificacion     ZonaPlanificacion? @relation(fields: [zonaPlanificacionId], references: [id])
  zonaPlanificacionId   String?
  campoPlanificacion    CampoPlanificacion? @relation(fields: [campoPlanificacionId], references: [id])
  campoPlanificacionId  String?
  costoEstimadoPorHa    Float    @default(0)
  activo                Boolean  @default(true)
  createdBy             String?
  updatedBy             String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  etapas                ProtocoloEtapa[]
  lineasPlanificacion   PlanificacionAgricolaLinea[]

  @@index([clienteId])
  @@index([campaniaErpId])
  @@index([actividadPlanificacionId])
  @@index([actividadErpId])
  @@index([zonaPlanificacionId])
  @@index([campoPlanificacionId])
  @@index([activo])
}

model ProtocoloEtapa {
  id                    String   @id @default(uuid())
  protocolo             ProtocoloProductivo @relation(fields: [protocoloId], references: [id])
  protocoloId           String
  estadioReferencia     EstadioFenologicoReferencia? @relation(fields: [estadioReferenciaId], references: [id])
  estadioReferenciaId   String?
  estadioCodigo         String?
  orden                 Int
  nombre                String
  descripcion           String?
  fechaObjetivo         DateTime?
  diasDesdeSiembra      Int?
  observaciones         String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  labores               ProtocoloLabor[]
  insumos               ProtocoloInsumo[]

  @@unique([protocoloId, estadioReferenciaId])
  @@index([protocoloId])
  @@index([estadioReferenciaId])
  @@index([orden])
}

model ProtocoloLabor {
  id                    String   @id @default(uuid())
  etapa                 ProtocoloEtapa @relation(fields: [etapaId], references: [id])
  etapaId               String
  laborReferencia       LaborReferencia? @relation(fields: [laborReferenciaId], references: [id])
  laborReferenciaId     String?
  indiceAplicacion      Float
  nombre                String
  descripcion           String?
  unidad                String
  cantidadPorHa         Float
  costoUnitario         Float
  costoPorHa            Float
  momentoEstimado       String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([etapaId])
  @@index([laborReferenciaId])
  @@index([indiceAplicacion])
}

model ProtocoloInsumo {
  id                    String   @id @default(uuid())
  etapa                 ProtocoloEtapa @relation(fields: [etapaId], references: [id])
  etapaId               String
  indiceAplicacion      Float
  insumoPlanificacion   InsumoPlanificacion @relation(fields: [insumoPlanificacionId], references: [id])
  insumoPlanificacionId String
  insumoErpId           String?
  nombre                String
  tipo                  String?
  unidad                String
  dosisPorHa            Float
  precioUnitarioEstimado Float
  costoPorHa            Float
  momentoEstimado       String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([etapaId])
  @@index([insumoPlanificacionId])
  @@index([insumoErpId])
  @@index([indiceAplicacion])
}

model PlanificacionAgricola {
  id              String   @id @default(uuid())
  cliente         Cliente  @relation(fields: [clienteId], references: [id])
  clienteId       String
  campaniaErpId   String
  nombre          String
  descripcion     String?
  estado          String   @default("borrador")
  cerradaPor      String?
  cerradaAt       DateTime?
  motivoCierre    String?
  createdBy       String?
  updatedBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  lineas          PlanificacionAgricolaLinea[]

  @@index([clienteId])
  @@index([campaniaErpId])
