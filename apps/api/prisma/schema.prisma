generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id          String    @id @default(uuid())
  email       String    @unique
  nombre      String?
  password    String?
  microsoftId String?   @unique
  rol         String    @default("operador_campo")
  cliente     Cliente?  @relation(fields: [clienteId], references: [id])
  clienteId   String?
  camposErpAsignados UsuarioCampoErp[]
  notificaciones NotificacionUsuario[]
  precipitaciones PrecipitacionCampo[]
  observaciones ObservacionCampo[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Cliente {
  id               String            @id @default(uuid())
  nombre           String
  activo           Boolean           @default(true)
  usuarios         Usuario[]
  integracionesErp IntegracionErp[]
  camposErpAsignados UsuarioCampoErp[]
  empresasErpAsignadas ClienteEmpresaErp[]
  zonasApp ZonaApp[]
  camposApp CampoApp[]
  lotesApp LoteApp[]
  especiesApp EspecieApp[]
  actividadesApp ActividadApp[]
  insumosApp InsumoApp[]
  estadiosReferencia EstadioFenologicoReferencia[]
  serviciosApp ServicioApp[]
  protocolosProductivos ProtocoloProductivo[]
  planificacionesAgricolas PlanificacionAgricola[]
  preciosApp PrecioApp[]
  destinosApp DestinoApp[]
  conceptosGastosComerciales ConceptoGastoComercialApp[]
  gastosComercialesReferencia GastoComercialApp[]
  vinculacionesErpSugeridas VinculacionErpSugerida[]
  notificaciones NotificacionUsuario[]
  precipitaciones PrecipitacionCampo[]
  observaciones ObservacionCampo[]
  observacionAdjuntos ObservacionAdjunto[]
  auditoriaEventos AuditoriaEvento[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model UsuarioCampoErp {
  id           String    @id @default(uuid())
  cliente     Cliente   @relation(fields: [clienteId], references: [id])
  clienteId    String
  usuario      Usuario   @relation(fields: [usuarioId], references: [id])
  usuarioId    String
  campoErpId   String
  asignadoPor  String?
  createdAt    DateTime  @default(now())

  @@unique([clienteId, usuarioId, campoErpId])
  @@index([clienteId])
  @@index([usuarioId])
  @@index([campoErpId])
}

model IntegracionErp {
  id                  String    @id @default(uuid())
  cliente             Cliente   @relation(fields: [clienteId], references: [id])
  clienteId           String
  baseUrl             String?
  authMode            String    @default("mock")
  apiKeyHeader        String    @default("x-api-key")
  apiKeyCifrada       String?
  bearerTokenCifrado  String?
  usernameCifrado     String?
  passwordCifrada     String?
  timeoutMs           Int       @default(15000)
  activo              Boolean   @default(true)
  ultimoTestOk        Boolean?
  ultimoTestEn        DateTime?
  ultimoSyncEn        DateTime?
  configuradoPor      String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@unique([clienteId])
  @@index([activo])
}

model ErpSincronizacion {
  id                String   @id @default(uuid())
  clienteId         String
  usuarioId         String?
  estado            String   @default("en_proceso")
  itemsSolicitados  Json
  itemsEjecutados   Json
  resultado         Json?
  error             String?
  iniciadoEn        DateTime @default(now())
  finalizadoEn      DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  detalles          ErpSincronizacionDetalle[]

  @@index([clienteId])
  @@index([usuarioId])
  @@index([estado])
  @@index([iniciadoEn])
}

model ErpSincronizacionDetalle {
  id                String   @id @default(uuid())
  sincronizacion    ErpSincronizacion @relation(fields: [sincronizacionId], references: [id])
  sincronizacionId  String
  empresaErpId      String
  padron            String
  registros         Int      @default(0)
  omitidos          Int      @default(0)
  estado            String   @default("completada")
  error             String?
  createdAt         DateTime @default(now())

  @@index([sincronizacionId])
  @@index([empresaErpId])
  @@index([padron])
  @@index([estado])
}

model ErpCampo {
  id             String    @id @default(uuid())
  empresaErpId   String
  erpId          String    @unique
  idCampo        Int
  idZona         Int?
  idSubZona      Int?
  codigo         String
  nombre         String
  paisCodigo     String?
  sociedad       String?
  admiteGanaderia Boolean?
  domicilio      String?
  codigoSima     Int?
  idLocalidad    Int?
  activo         Boolean   @default(true)
  actualizadoEn  DateTime
  importadoEn    DateTime  @default(now())
  lotes          ErpLote[]

  @@index([codigo])
  @@index([activo])
  @@index([empresaErpId])
}

model ErpZona {
  id           String   @id @default(uuid())
  empresaErpId String
  erpId        String   @unique
  idZona       Int
  codigo       String
  nombre       String
  activo       Boolean  @default(true)
  importadoEn  DateTime @default(now())

  @@index([codigo])
  @@index([activo])
  @@index([empresaErpId])
}

model ErpLote {
  id             String         @id @default(uuid())
  empresaErpId   String
  erpId          String         @unique
  idLote         Int
  idCampo        Int
  campoErpId     String
  campo          ErpCampo       @relation(fields: [campoErpId], references: [erpId])
  codigo         String
  nombre         String
  cultivoCodigo  String?
  cultivoNombre  String?
  areaHectareas  Float
  hectareasProductivas Float?
  admiteGanaderia Boolean?
  admiteLecheria  Boolean?
  codigoSima     Int?
  activo         Boolean        @default(true)
  actualizadoEn  DateTime
  importadoEn    DateTime       @default(now())

  @@index([idLote])
  @@index([idCampo])
  @@index([campoErpId])
  @@index([codigo])
  @@index([activo])
  @@index([empresaErpId])
}

model ErpActividad {
  id                String    @id @default(uuid())
  empresaErpId      String
  erpId             String    @unique
  idActividad       Int
  codigo            String
  descripcion       String
  activo            Boolean
  habilitadoExportacionCrea Boolean
  idEspecie         Int?
  idTipoActividad   Int?
  actualizadoEn     DateTime
  importadoEn       DateTime  @default(now())

  @@index([idActividad])
  @@index([idTipoActividad])
  @@index([activo])
  @@index([empresaErpId])
}

model ErpEspecie {
  id             String    @id @default(uuid())
  empresaErpId   String
  erpId          String    @unique
  idEspecie      Int
  codigo         String
  nombre         String
  activo         Boolean
  codigoCot      String?
  codigoAfip     Int?
  actualizadoEn  DateTime
  importadoEn    DateTime  @default(now())

  @@index([idEspecie])
  @@index([codigo])
  @@index([activo])
  @@index([empresaErpId])
}

model ErpEmpresa {
  id             String    @id @default(uuid())
  erpId          String    @unique
  idEmpresa      Int
  codigo         String
  nombre         String
  activo         Boolean
  cuit           String?
  razonSocial    String?
  email          String?
  actualizadoEn  DateTime
  importadoEn    DateTime  @default(now())

  @@index([idEmpresa])
  @@index([codigo])
  @@index([activo])
}

model ErpCampania {
  id             String    @id @default(uuid())
  empresaErpId   String
  erpId          String    @unique
  idCampania     Int
  codigo         String
  nombre         String
  activo         Boolean
  esActual       Boolean
  actualizadoEn  DateTime
  importadoEn    DateTime  @default(now())

  @@index([empresaErpId])
  @@index([idCampania])
  @@index([codigo])
  @@index([activo])
  @@index([esActual])
}

model ErpCultivo {
  id                       String    @id @default(uuid())
  empresaErpId             String
  erpId                    String    @unique
  idCultivo                Int
  codigo                   String
  nombre                   String
  idCampo                  Int
  campoErpId               String
  idLote                   Int
  loteErpId                String
  idActividad              Int?
  actividadErpId           String?
  idEspecie                Int?
  especieErpId             String?
  idCampania               Int?
  campaniaErpId            String?
  hectareas                Float
  hectareasSembradas       Float
  hectareasCosechadas      Float
  idPuerto                 Int?
  distanciaPuerto          Float?
  idPersonalResponsable    Int?
  esAgriculturaIntensiva   Boolean
  socioEnFuncionAportes    Boolean
  activo                   Boolean
  actualizadoEn            DateTime
  importadoEn              DateTime  @default(now())

  @@index([empresaErpId])
  @@index([idCultivo])
  @@index([campoErpId])
  @@index([loteErpId])
  @@index([campaniaErpId])
  @@index([activo])
}

model ErpInsumo {
  id                      String    @id @default(uuid())
  empresaErpId            String
  erpId                   String    @unique
  idInsumo                Int
  idUnidadMedida          Int?
  idTipoInsumo            Int?
  idCategoriaInsumo       Int?
  codigo                  String
  nombre                  String
  activo                  Boolean
  controlaStock           Boolean
  esInsumoGenerico        Boolean
  controlaPorLote         Boolean
  precioUnitario          Float?
  precioUnitarioVenta     Float?
  unidadesBulto           Float?
  idMonedaPrecioUnitario  Int?
  idMonedaPrecioVenta     Int?
  idCuentaContable        Int?
  idInsumoBanda           Int?
  idInsumoEstandar        Int?
  actualizadoEn           DateTime
  importadoEn             DateTime  @default(now())

  @@index([empresaErpId])
  @@index([idInsumo])
  @@index([codigo])
  @@index([nombre])
  @@index([idTipoInsumo])
  @@index([idCategoriaInsumo])
  @@index([activo])
}

model ErpTipoInsumo {
  id                 String   @id @default(uuid())
  empresaErpId       String
  erpId              String   @unique
  idTipoInsumo       Int
  codigo             String
  codigoCot          String?
  codigoSima         Int?
  descripcion        String
  activo             Boolean
  usaPadronEstandar  Boolean
  idCuentaContable   Int?
  actualizadoEn      DateTime
  importadoEn        DateTime @default(now())

  @@index([empresaErpId])
  @@index([idTipoInsumo])
  @@index([codigo])
  @@index([descripcion])
  @@index([activo])
}

model ErpServicio {
  id                    String    @id @default(uuid())
  empresaErpId          String
  erpId                 String    @unique
  idServicio            Int
  idTipoServicio        Int?
  codigo                String
  descripcion           String
  descripcionAbreviada  String?
  idUnidadMedida        Int?
  idMoneda              Int?
  precioUnitario        Float?
  idMonedaPersonal      Int?
  importePersonal       Float?
  activo                Boolean
  imputaDosis           Boolean
  actualizadoEn         DateTime
  importadoEn           DateTime  @default(now())

  @@index([empresaErpId])
  @@index([idServicio])
  @@index([codigo])
  @@index([descripcion])
  @@index([idTipoServicio])
  @@index([idUnidadMedida])
  @@index([activo])
}

model ErpTipoServicio {
  id                  String   @id @default(uuid())
  empresaErpId        String
  erpId               String   @unique
  idTipoServicio      Int
  codigo              String
  descripcion         String
  exigeInsumo         Boolean
  disponibleOt        Boolean
  disponibleCompras   Boolean
  disponibleVentas    Boolean
  categoria           String?
  idCuentaContable    Int?
  actualizadoEn       DateTime
  importadoEn         DateTime @default(now())

  @@index([empresaErpId])
  @@index([idTipoServicio])
  @@index([codigo])
  @@index([descripcion])
}

model ErpMoneda {
  id             String    @id @default(uuid())
  empresaErpId   String
  erpId          String    @unique
  idMoneda       Int
  codigo         String
  nombre         String
  simbolo        String?
  activo         Boolean
  actualizadoEn  DateTime
  importadoEn    DateTime  @default(now())

  @@index([empresaErpId])
  @@index([idMoneda])
  @@index([codigo])
  @@index([nombre])
  @@index([activo])
}

model ErpUnidadMedida {
  id                    String    @id @default(uuid())
  empresaErpId          String
  erpId                 String    @unique
  idUnidadMedida        Int
  codigo                String
  codigoSifen           String?
  descripcion           String
  activo                Boolean
  actualizadoEn         DateTime
  importadoEn           DateTime  @default(now())

  @@index([empresaErpId])
  @@index([idUnidadMedida])
  @@index([codigo])
  @@index([activo])
}

model ErpPuerto {
  id             String    @id @default(uuid())
  empresaErpId   String
  erpId          String    @unique
  idPuerto       Int
  codigo         String
  nombre         String
  activo         Boolean
  actualizadoEn  DateTime
  importadoEn    DateTime  @default(now())

  @@index([empresaErpId])
  @@index([idPuerto])
  @@index([codigo])
  @@index([nombre])
  @@index([activo])
}

model ClienteEmpresaErp {
  id           String    @id @default(uuid())
  cliente      Cliente   @relation(fields: [clienteId], references: [id])
  clienteId    String
  empresaErpId String
  asignadoPor  String?
  createdAt    DateTime  @default(now())

  @@unique([clienteId, empresaErpId])
  @@index([clienteId])
  @@index([empresaErpId])
}

model ZonaApp {
  id                String   @id @default(uuid())
  cliente           Cliente  @relation(fields: [clienteId], references: [id])
  clienteId         String
  empresaErpId      String
  zonaErpId         String?
  nombre            String
  codigoInterno     String?
  estadoVinculacion String   @default("provisorio")
  createdBy         String?
  updatedBy         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  campos            CampoApp[]
  protocolos        ProtocoloProductivo[]

  @@index([clienteId])
  @@index([empresaErpId])
  @@index([zonaErpId])
  @@index([estadoVinculacion])
}

model CampoApp {
  id                String   @id @default(uuid())
  cliente           Cliente  @relation(fields: [clienteId], references: [id])
  clienteId         String
  empresaErpId      String
  campoErpId        String?
  zonaApp ZonaApp? @relation(fields: [zonaAppId], references: [id])
  zonaAppId String?
  zonaErpId         String?
  nombre            String
  codigoInterno     String?
  estadoVinculacion String   @default("provisorio")
  createdBy         String?
  updatedBy         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  lotes             LoteApp[]
  protocolos        ProtocoloProductivo[]
  precipitaciones   PrecipitacionCampo[]
  observaciones     ObservacionCampo[]
  lineasPlanificacion PlanificacionAgricolaLinea[]

  @@index([clienteId])
  @@index([empresaErpId])
  @@index([campoErpId])
  @@index([zonaAppId])
  @@index([estadoVinculacion])
}

model LoteApp {
  id                String   @id @default(uuid())
  cliente           Cliente  @relation(fields: [clienteId], references: [id])
  clienteId         String
  campo             CampoApp @relation(fields: [campoAppId], references: [id])
  campoAppId String
  loteErpId         String?
  nombre            String
  codigoInterno     String?
  superficieTotal   Float
  superficieProductiva Float
  estadoVinculacion String   @default("provisorio")
  createdBy         String?
  updatedBy         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  precipitaciones   PrecipitacionCampo[]
  observaciones     ObservacionCampo[]
  lineasPlanificacion PlanificacionAgricolaLinea[]

  @@index([clienteId])
  @@index([campoAppId])
  @@index([loteErpId])
  @@index([estadoVinculacion])
}

model PrecipitacionCampo {
  id                    String   @id @default(uuid())
  cliente               Cliente  @relation(fields: [clienteId], references: [id])
  clienteId             String
  usuario               Usuario? @relation(fields: [usuarioId], references: [id])
  usuarioId             String?
  campoApp    CampoApp @relation(fields: [campoAppId], references: [id])
  campoAppId  String
  campoErpId            String?
  loteApp     LoteApp? @relation(fields: [loteAppId], references: [id])
  loteAppId   String?
  loteErpId             String?
  registroMovilId       String?
  milimetros            Float
  fechaEvento           DateTime
  observaciones         String?
  origen                String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([clienteId])
  @@index([usuarioId])
  @@index([campoAppId])
  @@index([loteAppId])
  @@index([registroMovilId])
  @@index([fechaEvento])
  @@index([origen])
  @@unique([clienteId, registroMovilId])
}

model ObservacionCampo {
  id                    String   @id @default(uuid())
  cliente               Cliente  @relation(fields: [clienteId], references: [id])
  clienteId             String
  usuario               Usuario? @relation(fields: [usuarioId], references: [id])
  usuarioId             String?
  campoApp              CampoApp @relation(fields: [campoAppId], references: [id])
  campoAppId            String
  campoErpId            String?
  loteApp               LoteApp? @relation(fields: [loteAppId], references: [id])
  loteAppId             String?
  loteErpId             String?
  registroMovilId       String?
  titulo                String
  descripcion           String
  severidad             String   @default("media")
  latitud               Float?
  longitud              Float?
  fechaEvento           DateTime
  origen                String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  adjuntos              ObservacionAdjunto[]

  @@index([clienteId])
  @@index([usuarioId])
  @@index([campoAppId])
  @@index([loteAppId])
  @@index([registroMovilId])
  @@index([severidad])
  @@index([fechaEvento])
  @@index([origen])
  @@unique([clienteId, registroMovilId])
}

model ObservacionAdjunto {
  id              String   @id @default(uuid())
  cliente         Cliente  @relation(fields: [clienteId], references: [id])
  clienteId       String
  observacion     ObservacionCampo @relation(fields: [observacionId], references: [id], onDelete: Cascade)
  observacionId   String
  storageBucket   String
  storagePath     String
  nombreArchivo   String
  mimeType        String
  tamanioBytes    Int
  checksumSha256  String?
  estado          String   @default("disponible")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([clienteId, storageBucket, storagePath])
  @@index([clienteId])
  @@index([observacionId])
  @@index([estado])
  @@index([mimeType])
}

model EspecieApp {
  id                String   @id @default(uuid())
  cliente           Cliente  @relation(fields: [clienteId], references: [id])
  clienteId         String
  empresaErpId      String
  especieErpId      String?
  nombre            String
  codigoInterno     String?
  estadoVinculacion String   @default("provisorio")
  createdBy         String?
  updatedBy         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  actividades       ActividadApp[]
  preciosApp PrecioApp[]

  @@index([clienteId])
  @@index([empresaErpId])
  @@index([especieErpId])
  @@index([estadoVinculacion])
}

model ActividadApp {
  id                    String   @id @default(uuid())
  cliente               Cliente  @relation(fields: [clienteId], references: [id])
  clienteId             String
  empresaErpId          String
  actividadErpId        String?
  especieApp  EspecieApp? @relation(fields: [especieAppId], references: [id])
  especieAppId String?
  especieErpId          String?
  nombre                String
  codigoInterno         String?
  tipoGrano             String?
  tipoCultivo           String?
  epocaSiembra          String?
  estadoVinculacion     String   @default("provisorio")
  createdBy             String?
  updatedBy             String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  protocolos            ProtocoloProductivo[]
  lineasPlanificacion   PlanificacionAgricolaLinea[]
  destinosApp           DestinoApp[]
  preciosApp            PrecioApp[]
  gastosReferencia      GastoComercialApp[]

  @@index([clienteId])
  @@index([empresaErpId])
  @@index([actividadErpId])
  @@index([especieAppId])
  @@index([estadoVinculacion])
}

model InsumoApp {
  id                    String   @id @default(uuid())
  cliente               Cliente  @relation(fields: [clienteId], references: [id])
  clienteId             String
  empresaErpId          String
  insumoErpId           String?
  nombre                String
  codigoInterno         String?
  idTipoInsumo          Int?
  tipo                  String?
  unidad                String
  precioUnitarioEstimado Float?
  moneda                String?
  estadoVinculacion     String   @default("provisorio")
  createdBy             String?
  updatedBy             String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  insumosProtocolo      ProtocoloInsumo[]

  @@index([clienteId])
  @@index([empresaErpId])
  @@index([insumoErpId])
  @@index([idTipoInsumo])
  @@index([estadoVinculacion])
}

model EstadioFenologicoReferencia {
  id                String   @id @default(uuid())
  cliente           Cliente  @relation(fields: [clienteId], references: [id])
  clienteId         String
  idEstadio         Int
  actividadErpId    String?
  codigo            String
  nombre            String
  ordenCronologico  Int
  empresaErpId      String?
  activo            Boolean  @default(true)
  origen            String   @default("semilla")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  etapas            ProtocoloEtapa[]

  @@unique([clienteId, idEstadio])
  @@index([clienteId])
  @@index([actividadErpId])
  @@index([codigo])
  @@index([ordenCronologico])
  @@index([activo])
}

model ServicioApp {
  id                    String   @id @default(uuid())
  cliente               Cliente  @relation(fields: [clienteId], references: [id])
  clienteId             String
  empresaErpId          String?
  servicioErpId         String?
  idServicio            Int?
  idTipoServicio        Int?
  codigo                String
  nombre                String
  descripcionAbreviada  String?
  idUnidadMedida        Int?
  idMoneda              Int?
  unidadSugerida        String
  costoUnitarioSugerido Float?
  imputaDosis           Boolean?
  estadoVinculacion     String   @default("provisorio")
  activo                Boolean  @default(true)
  origen                String   @default("semilla")
  fechaUltimaActualizacionErp DateTime?
  createdBy             String?
  updatedBy             String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  labores               ProtocoloLabor[]

  @@unique([clienteId, codigo])
  @@unique([clienteId, servicioErpId])
  @@index([clienteId])
  @@index([empresaErpId])
  @@index([servicioErpId])
  @@index([nombre])
  @@index([estadoVinculacion])
  @@index([activo])
}

model ProtocoloProductivo {
  id                    String   @id @default(uuid())
  cliente               Cliente  @relation(fields: [clienteId], references: [id])
  clienteId             String
  nombre                String
  descripcion           String
  protocoloOrigenId     String?
  empresaErpId          String?
  campaniaErpId         String
  actividadApp ActividadApp @relation(fields: [actividadAppId], references: [id])
  actividadAppId String
  actividadErpId        String?
  tipoFecha             String
  fechaSiembra          DateTime?
  zonaApp     ZonaApp? @relation(fields: [zonaAppId], references: [id])
  zonaAppId   String?
  campoApp    CampoApp? @relation(fields: [campoAppId], references: [id])
  campoAppId  String?
  costoEstimadoPorHa    Float    @default(0)
  activo                Boolean  @default(true)
  createdBy             String?
  updatedBy             String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  etapas                ProtocoloEtapa[]
  lineasPlanificacion   PlanificacionAgricolaLinea[]

  @@index([clienteId])
  @@index([campaniaErpId])
  @@index([actividadAppId])
  @@index([actividadErpId])
  @@index([zonaAppId])
  @@index([campoAppId])
  @@index([activo])
}

model ProtocoloEtapa {
  id                    String   @id @default(uuid())
  protocolo             ProtocoloProductivo @relation(fields: [protocoloId], references: [id])
  protocoloId           String
  estadioReferencia     EstadioFenologicoReferencia? @relation(fields: [estadioReferenciaId], references: [id])
  estadioReferenciaId   String?
  estadioCodigo         String?
  orden                 Int
  nombre                String
  descripcion           String?
  fechaObjetivo         DateTime?
  diasDesdeSiembra      Int?
  observaciones         String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  labores               ProtocoloLabor[]
  insumos               ProtocoloInsumo[]

  @@unique([protocoloId, estadioReferenciaId])
  @@index([protocoloId])
  @@index([estadioReferenciaId])
  @@index([orden])
}

model ProtocoloLabor {
  id                    String   @id @default(uuid())
  etapa                 ProtocoloEtapa @relation(fields: [etapaId], references: [id])
  etapaId               String
  servicioApp           ServicioApp? @relation(fields: [servicioAppId], references: [id])
  servicioAppId         String?
  indiceAplicacion      Float
  nombre                String
  descripcion           String?
  unidad                String
  cantidadPorHa         Float
  costoUnitario         Float
  costoPorHa            Float
  momentoEstimado       String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([etapaId])
  @@index([servicioAppId])
  @@index([indiceAplicacion])
}

model ProtocoloInsumo {
  id                    String   @id @default(uuid())
  etapa                 ProtocoloEtapa @relation(fields: [etapaId], references: [id])
  etapaId               String
  indiceAplicacion      Float
  insumoApp   InsumoApp @relation(fields: [insumoAppId], references: [id])
  insumoAppId String
  insumoErpId           String?
  nombre                String
  tipo                  String?
  unidad                String
  dosisPorHa            Float
  precioUnitarioEstimado Float
  costoPorHa            Float
  momentoEstimado       String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([etapaId])
  @@index([insumoAppId])
  @@index([insumoErpId])
  @@index([indiceAplicacion])
}

model PlanificacionAgricola {
  id              String   @id @default(uuid())
  cliente         Cliente  @relation(fields: [clienteId], references: [id])
  clienteId       String
  campaniaErpId   String
  nombre          String
  descripcion     String?
  estado          String   @default("borrador")
  escenarioOriginal Boolean @default(false)
  escenarioBloqueadoPorId String?
  cerradaPor      String?
  cerradaAt       DateTime?
  motivoCierre    String?
  createdBy       String?
  updatedBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  lineas          PlanificacionAgricolaLinea[]

  @@index([clienteId])
  @@index([campaniaErpId])
  @@index([estado])
  @@index([escenarioOriginal])
  @@index([escenarioBloqueadoPorId])
}

model PlanificacionAgricolaLinea {
  id                          String   @id @default(uuid())
  planificacion               PlanificacionAgricola @relation(fields: [planificacionId], references: [id])
  planificacionId             String
  empresaErpId                String
  campoApp          CampoApp @relation(fields: [campoAppId], references: [id])
  campoAppId        String
  campoErpId                  String?
  loteApp           LoteApp @relation(fields: [loteAppId], references: [id])
  loteAppId         String
  loteErpId                   String?
  actividadApp      ActividadApp @relation(fields: [actividadAppId], references: [id])
  actividadAppId    String
  actividadErpId              String?
  cultivoErpId                String?
  destinoReferenciaId         String?
  destinoVenta                String
  destinoVentaManual          Boolean  @default(false)
  precioReferenciaId          String?
  precioVentaEstimado         Float
  precioVentaManual           Boolean  @default(false)
  hectareasPlanificadas       Float
  rindeEstimado               Float
  gastosComercialesReferenciaId String?
  gastosComercialesEstimados  Float
  protocolo                   ProtocoloProductivo? @relation(fields: [protocoloId], references: [id])
  protocoloId                 String?
  ingresoBrutoEstimado        Float
  ingresoNetoEstimado         Float
  costoProduccionEstimado     Float
  margenBrutoEstimado         Float
  margenBrutoActualizado      Float?
  estado                      String   @default("borrador")
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  @@unique([planificacionId, campoAppId, loteAppId, actividadAppId])
  @@index([planificacionId])
  @@index([campoAppId])
  @@index([loteAppId])
  @@index([actividadAppId])
  @@index([actividadErpId])
  @@index([protocoloId])
}

